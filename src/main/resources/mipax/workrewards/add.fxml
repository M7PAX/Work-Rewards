<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mipax.workrewards.Add">
   <children>
      <VBox layoutX="100.0" layoutY="50.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="50.0">
         <children>
            <HBox>
               <children>
                  <VBox prefWidth="350.0">
                     <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Work">
                           <VBox.margin>
                              <Insets bottom="5.0" />
                           </VBox.margin>
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Text>
                        <TextField fx:id="workInput" maxWidth="1.7976931348623157E308" promptText="Work To Do...">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <VBox.margin>
                              <Insets bottom="20.0" />
                           </VBox.margin>
                        </TextField>
                        <ToggleButton fx:id="DDCB" mnemonicParsing="false" onMouseClicked="#toggleDueDate" text="Due Date">
                           <VBox.margin>
                              <Insets bottom="5.0" />
                           </VBox.margin>
                        </ToggleButton>
                        <HBox fx:id="dueDateBox" disable="true" fillHeight="false">
                           <children>
                              <DatePicker fx:id="dueDate" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefWidth="250.0" />
                              <TextField fx:id="dueH" prefWidth="50.0">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                                 <HBox.margin>
                                    <Insets left="10.0" />
                                 </HBox.margin>
                              </TextField>
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" text=":">
                                 <font>
                                    <Font size="18.0" />
                                 </font>
                              </Text>
                              <TextField fx:id="dueMin" prefWidth="50.0">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </TextField>
                           </children>
                           <VBox.margin>
                              <Insets bottom="20.0" />
                           </VBox.margin>
                        </HBox>
                        <ToggleButton fx:id="HLCB" mnemonicParsing="false" onMouseClicked="#toggleHL" text="Hyperlink">
                           <VBox.margin>
                              <Insets bottom="5.0" />
                           </VBox.margin>
                        </ToggleButton>
                        <TextField fx:id="HLInput" disable="true" maxWidth="1.7976931348623157E308" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <HBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </HBox.margin>
                  </VBox>
                  <VBox prefWidth="350.0">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                     <HBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </HBox.margin>
                     <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Categories">
                           <font>
                              <Font size="18.0" />
                           </font>
                           <VBox.margin>
                              <Insets bottom="5.0" />
                           </VBox.margin>
                        </Text>
                        <ChoiceBox fx:id="categoryC" maxWidth="1.7976931348623157E308">
                           <VBox.margin>
                              <Insets bottom="5.0" />
                           </VBox.margin>
                        </ChoiceBox>
                        <TextField fx:id="newCategoryInput" maxWidth="1.7976931348623157E308" promptText="New Category" visible="false" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Description">
               <font>
                  <Font size="18.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="5.0" left="20.0" />
               </VBox.margin>
            </Text>
            <TextArea fx:id="descriptionInput" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="150.0" prefWidth="700.0" wrapText="true">
               <font>
                  <Font size="14.0" />
               </font>
               <VBox.margin>
                  <Insets left="20.0" right="20.0" />
               </VBox.margin>
            </TextArea>
            <Button fx:id="addWorkB" disable="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onMouseClicked="#addWork" text="Add Work">
               <VBox.margin>
                  <Insets bottom="5.0" left="20.0" right="20.0" top="20.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>
